[Unit]
Description=Daemon Device — local daemon protocol bridge
Documentation=https://github.com/arthurwiedmer/daemon
After=network-online.target daemon-web.service
Wants=network-online.target

[Service]
Type=simple
User=arthur
Group=arthur
WorkingDirectory=/home/arthur/daemon/cli
Environment=NODE_ENV=production
Environment=DAEMON_NO_UPDATE=1
Environment=PATH=/home/arthur/.local/bin:/home/arthur/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/home/arthur/.secrets/vault.env
ExecStart=/usr/bin/node /home/arthur/daemon/cli/daemon.mjs --no-update --name arturito
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/daemon-device.log
StandardError=append:/var/log/daemon-device.log

# Hardening — minimal because the device IS supposed to be the user's
# filesystem agent. PrivateTmp would mask /tmp and /var/tmp from the daemon
# even though the user expects "read /tmp/foo.txt" to just work.
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target

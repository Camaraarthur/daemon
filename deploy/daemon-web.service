[Unit]
Description=Daemon Web UI
After=network.target

[Service]
Type=simple
User=arthur
WorkingDirectory=/home/arthur/daemon/web
Environment=PORT=4800
Environment=NODE_ENV=production
Environment=DAEMON_OPERATOR_USER_ID=3
Environment=PATH=/home/arthur/.local/bin:/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/home/arthur
EnvironmentFile=/home/arthur/.secrets/vault.env
ExecStart=/bin/bash /home/arthur/daemon/web/start.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

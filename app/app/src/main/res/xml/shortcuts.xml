<?xml version="1.0" encoding="utf-8"?>
<!--
    Direct-share + Sharing Shortcuts: tells Android that daemon is a
    sharing destination for any data type, so it can surface daemon in
    the top "direct share" row of the share sheet (in addition to the
    catch-all intent filters in AndroidManifest.xml).

    Apps that subsequently push dynamic shortcuts via
    ShortcutManagerCompat.pushDynamicShortcut() with the matching
    category will rank even higher. v0.1 ships with the static
    share-target only; dynamic-shortcut promotion can land later.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="dev.daemon.app.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="dev.daemon.app.category.SHARE_TARGET" />
    </share-target>
</shortcuts>

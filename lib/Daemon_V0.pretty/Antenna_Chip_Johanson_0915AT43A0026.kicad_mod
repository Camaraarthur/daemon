(footprint "Antenna_Chip_Johanson_0915AT43A0026"
  (version 20240108)
  (generator "manual_fix_from_datasheet")
  (layer "F.Cu")
  (descr "Johanson 0915AT43A0026 915MHz chip antenna, 7.0x2.0x0.8mm, pin1=feed, pin2=NC(anchor)")
  (tags "antenna chip 915MHz ISM sub-GHz Johanson")
  (attr smd)
  (fp_text reference "REF**" (at 0 -2.5) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "0915AT43A0026" (at 0 2.5) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  ;; Silkscreen outline (body 7.0 x 2.0mm)
  (fp_line (start -3.7 -1.2) (end 3.7 -1.2) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
  (fp_line (start -3.7 1.2) (end 3.7 1.2) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
  ;; Courtyard (body + 0.5mm clearance)
  (fp_line (start -4.2 -1.7) (end 4.2 -1.7) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (fp_line (start -4.2 1.7) (end 4.2 1.7) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (fp_line (start -4.2 -1.7) (end -4.2 1.7) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  (fp_line (start 4.2 -1.7) (end 4.2 1.7) (stroke (width 0.05) (type default)) (layer "F.CrtYd"))
  ;; Fab layer (exact body 7.0 x 2.0mm)
  (fp_line (start -3.5 -1.0) (end 3.5 -1.0) (stroke (width 0.1) (type default)) (layer "F.Fab"))
  (fp_line (start -3.5 1.0) (end 3.5 1.0) (stroke (width 0.1) (type default)) (layer "F.Fab"))
  (fp_line (start -3.5 -1.0) (end -3.5 1.0) (stroke (width 0.1) (type default)) (layer "F.Fab"))
  (fp_line (start 3.5 -1.0) (end 3.5 1.0) (stroke (width 0.1) (type default)) (layer "F.Fab"))
  ;; Pin 1 marker
  (fp_line (start -3.5 -0.5) (end -3.0 -1.0) (stroke (width 0.1) (type default)) (layer "F.Fab"))
  ;; Pad 1 (Feed) - left side, a=0.5mm wide, W=2.0mm tall
  ;; Datasheet: pad width 0.5mm, centered at left edge
  (pad "1" smd rect (at -3.25 0) (size 0.5 2.0) (layers "F.Cu" "F.Paste" "F.Mask"))
  ;; Pad 2 (NC/anchor) - right side, same size
  (pad "2" smd rect (at 3.25 0) (size 0.5 2.0) (layers "F.Cu" "F.Paste" "F.Mask"))
  (model "${KIPRJMOD}/lib/3dmodels/Antenna_Johanson_0915AT43A0026.step"
    (offset (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0))
  )
)
